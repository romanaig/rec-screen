<Window x:Class="RecScreen.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rec Screen - Settings"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16" Width="380">
        <TextBlock Text="Monitor" FontWeight="SemiBold" />
        <ComboBox x:Name="MonitorBox" Margin="0,4,0,16" />

        <TextBlock Text="Audio input" FontWeight="SemiBold" />
        <CheckBox x:Name="SystemAudioBox" Content="System audio" Margin="0,6,0,0" />
        <CheckBox x:Name="MicrophoneBox" Content="Microphone" Margin="0,6,0,0" />
        <ComboBox x:Name="MicBox" Margin="20,4,0,0"
                  IsEnabled="{Binding IsChecked, ElementName=MicrophoneBox}" />
        <TextBlock Margin="0,8,0,16">
            <Hyperlink Click="OpenSoundSettings">Windows sound settings…</Hyperlink>
        </TextBlock>

        <TextBlock Text="Save to" FontWeight="SemiBold" />
        <DockPanel Margin="0,4,0,20">
            <Button Content="Change…" DockPanel.Dock="Right" Padding="10,2" Margin="6,0,0,0" Click="ChooseFolder" />
            <TextBox x:Name="FolderBox" IsReadOnly="True" VerticalContentAlignment="Center" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" IsDefault="True" Click="Save" />
            <Button Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" Click="Cancel" />
        </StackPanel>
    </StackPanel>
</Window>
