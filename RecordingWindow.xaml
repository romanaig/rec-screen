<Window x:Class="RecScreen.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rec Screen - recording (click to stop)"
        Width="280" Height="90" ResizeMode="NoResize"
        WindowState="Minimized" ShowActivated="False" WindowStartupLocation="CenterScreen">

    <!-- Red dot on the taskbar icon while recording. -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="Recording - click to stop">
            <TaskbarItemInfo.Overlay>
                <DrawingImage>
                    <DrawingImage.Drawing>
                        <GeometryDrawing Brush="#E53935">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry RadiusX="8" RadiusY="8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingImage.Drawing>
                </DrawingImage>
            </TaskbarItemInfo.Overlay>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <!-- Only visible for the moment between clicking to stop and the file being finalized. -->
    <TextBlock Text="Saving recording…" FontSize="14"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
</Window>
